# Network RPC endpoint used by the deployment commands below.
RPC_URL=

# Deployment account private key (0x-prefixed hex; do not commit).
PRIVATE_KEY=

# Initial fee-vault administrator and destination for collected dev fees.
DEV_ADDRESS=
DEV_FEE_RECEIVER=

# Optional existing pool to create a Karma oracle during deployment.
PREDICTION_POOL=
TAU=124651
MIN_BALANCE=100000000000000000000
DESCRIPTION=Karma Oracle

# Block explorer API key used by `forge verify-contract` and `forge script --verify`.
ETHERSCAN_API_KEY=
